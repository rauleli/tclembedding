# Top-level Makefile for tclembedding extension

VPATH = @srcdir@
srcdir = @srcdir@
top_srcdir = @top_srcdir@

# Installation directories
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
libdir = @libdir@
includedir = @includedir@

INSTALL = @INSTALL@

SUBDIRS = unix

all: all-recursive

clean: clean-recursive

distclean: distclean-recursive
	rm -f config.status config.log configure

install: install-recursive

# Test targets are implemented by the configured Unix makefile.
test test-tokenizer test-tokenizer-rust test-tokenizer-abi test-tokenizer-embedding test-embedding-lifecycle test-embedding-safety test-embedding-batch:
	$(MAKE) -C unix $@

all-recursive clean-recursive distclean-recursive install-recursive:
	@for dir in $(SUBDIRS); do \
	  (cd $$dir && $(MAKE) $(@:-recursive=)); \
	done

.PHONY: all clean distclean install test test-tokenizer test-tokenizer-rust test-tokenizer-abi \
        test-tokenizer-embedding test-embedding-lifecycle test-embedding-safety test-embedding-batch \
        all-recursive clean-recursive distclean-recursive install-recursive
