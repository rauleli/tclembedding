# Makefile.in for tclembedding extension - Unix/Linux build
# Generated from unix/Makefile.in by configure
# Follows Tcl Extension Architecture (TEA) standards

VPATH = @srcdir@:@srcdir@/../generic
srcdir = @srcdir@
top_srcdir = @top_srcdir@

# Tcl configuration variables (set by configure)
TCLSH_PROG = @TCLSH_PROG@
TCL_INCLUDE_SPEC = @TCL_INCLUDE_SPEC@
TCL_LIB_SPEC = @TCL_LIB_SPEC@
TCL_LIBS = @TCL_LIBS@
TCL_EXEC_PREFIX = @TCL_EXEC_PREFIX@
TCL_PREFIX = @TCL_PREFIX@

# Installation directories
prefix = @prefix@
exec_prefix = @exec_prefix@
libdir = @libdir@
includedir = @includedir@

# Module installation directory - where the .so file goes
override pkgdir = $(libdir)/tclembedding1.0
override package_install_dir = $(DESTDIR)$(pkgdir)
export package_install_dir

# Compilation settings
CC = @CC@
CFLAGS = @CFLAGS@ -std=c11 -fPIC -Wall -Wextra
INSTALL = @INSTALL@
CARGO ?= cargo
CARGO_TARGET_DIR ?= $(CURDIR)/cargo-target
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@ -lonnxruntime -lm
SIMD_OBJECTS = @SIMD_OBJECTS@
SIMD_CPPFLAGS = @SIMD_CPPFLAGS@
SIMD_SSE2_CFLAGS = @SIMD_SSE2_CFLAGS@
SIMD_AVX_CFLAGS = @SIMD_AVX_CFLAGS@
SIMD_AVX2_CFLAGS = @SIMD_AVX2_CFLAGS@
SIMD_BASE_CFLAGS = @SIMD_BASE_CFLAGS@
SIMILARITY_OBJECTS = similarity_dispatch.o similarity_scalar.o $(SIMD_OBJECTS)
SIMILARITY_GUARD = -include $(top_srcdir)/src/similarity_baseline.h

# Compiler settings
INCLUDE_DIRS = $(TCL_INCLUDE_SPEC) -I$(srcdir)/../generic

# Source files
SOURCES = tclembedding.c
OBJECTS = tclembedding.o

# Output library
SHARED_LIB = tclembedding.so
PACKAGE_NAME = tclembedding
VERSION = 1.0.0

# Default target
all: $(SHARED_LIB) tcltokenizer.so pkgIndex.tcl

pkgIndex.tcl: $(srcdir)/../pkgIndex.tcl.in
	cp $< $@

libtclembedding_tokenizer.so: $(srcdir)/../tokenizer-native/Cargo.toml $(srcdir)/../tokenizer-native/Cargo.lock $(srcdir)/../tokenizer-native/src/lib.rs
	CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" $(CARGO) build --release --locked --manifest-path $(srcdir)/../tokenizer-native/Cargo.toml
	cp "$(CARGO_TARGET_DIR)/release/libtclembedding_tokenizer.so" $@

tokenizer_bridge.o: $(srcdir)/../generic/tokenizer_bridge.c $(srcdir)/../tokenizer-native/hf_tokenizer.h
	$(CC) $(CPPFLAGS) $(CFLAGS) $(INCLUDE_DIRS) -c -o $@ $<

tcltokenizer.so: tokenizer_bridge.o libtclembedding_tokenizer.so
	$(CC) -shared $(LDFLAGS) -o $@ tokenizer_bridge.o -L. -ltclembedding_tokenizer $(TCL_LIB_SPEC) -Wl,-rpath,'$$ORIGIN'

# Build the shared library
$(SHARED_LIB): $(OBJECTS)
	$(CC) -shared $(LDFLAGS) -o $@ $(OBJECTS) $(TCL_LIB_SPEC) $(LIBS)

# Compile C source files
%.o: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(INCLUDE_DIRS) -c -o $@ $<

# Optional database extensions: headers are required only for these targets.
similarity_dispatch.o: $(top_srcdir)/src/similarity_dispatch.c $(top_srcdir)/src/similarity.h $(top_srcdir)/src/similarity_baseline.h Makefile
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMILARITY_GUARD) $(SIMD_CPPFLAGS) -c -o $@ $<
similarity_scalar.o: $(top_srcdir)/src/similarity.c $(top_srcdir)/src/similarity.h $(top_srcdir)/src/similarity_baseline.h Makefile
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMILARITY_GUARD) -fvisibility=hidden -DCOSINE_FORCE_SCALAR -Dsimilarity_cosine_f32le=similarity_scalar_cosine -Dsimilarity_dot_f32le=similarity_scalar_dot -c -o $@ $<
similarity_sse2.o: $(top_srcdir)/src/similarity.c $(top_srcdir)/src/similarity.h $(top_srcdir)/src/similarity_baseline.h Makefile
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMILARITY_GUARD) $(SIMD_SSE2_CFLAGS) -fvisibility=hidden -DCOSINE_ENABLE_SSE2 -Dsimilarity_cosine_f32le=similarity_sse2_cosine -Dsimilarity_dot_f32le=similarity_sse2_dot -c -o $@ $<
similarity_avx.o: $(top_srcdir)/src/similarity_avx.c Makefile
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMD_AVX_CFLAGS) -fvisibility=hidden -c -o $@ $<
similarity_avx2.o: $(top_srcdir)/src/similarity_avx.c Makefile
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMD_AVX2_CFLAGS) -DTCLEMBEDDING_AVX2 -fvisibility=hidden -c -o $@ $<
sqlite-similarity.so: $(SIMILARITY_OBJECTS) $(top_srcdir)/src/sqlite_similarity.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMILARITY_GUARD) $(SQLITE_CPPFLAGS) -shared $(LDFLAGS) -o $@ $(top_srcdir)/src/sqlite_similarity.c $(SIMILARITY_OBJECTS) -lm
mysql-cosine-v2.so: $(SIMILARITY_OBJECTS) $(top_srcdir)/src/rag_optimizations.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMILARITY_GUARD) $(MYSQL_CPPFLAGS) -Dcosine_similarity=cosine_similarity_v2 -Dcosine_similarity_init=cosine_similarity_v2_init -Dcosine_similarity_deinit=cosine_similarity_v2_deinit -shared $(LDFLAGS) -o $@ $(top_srcdir)/src/rag_optimizations.c $(SIMILARITY_OBJECTS) -lm
SIMILARITY_INSTALL_DIR ?= $(libdir)/tclembedding-similarity
install-sqlite-similarity: sqlite-similarity.so
	mkdir -p "$(DESTDIR)$(SIMILARITY_INSTALL_DIR)"
	$(INSTALL) $< "$(DESTDIR)$(SIMILARITY_INSTALL_DIR)/"
install-mysql-similarity: mysql-cosine-v2.so
	mkdir -p "$(DESTDIR)$(SIMILARITY_INSTALL_DIR)"
	$(INSTALL) $< "$(DESTDIR)$(SIMILARITY_INSTALL_DIR)/"
test-similarity-dispatch: $(SIMILARITY_OBJECTS)
	@test -n "$(SIMD_OBJECTS)" || { echo "SSE2 object not configured" >&2; exit 1; }
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) $(SIMILARITY_GUARD) -DTCLEMBEDDING_HAVE_SSE2 -c $(top_srcdir)/src/similarity_dispatch.c -o similarity_dispatch_sse2_test.o
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SIMD_BASE_CFLAGS) -pthread $(top_srcdir)/tests/similarity_dispatch_test.c similarity_dispatch_sse2_test.o similarity_scalar.o similarity_sse2.o -Wl,--wrap=similarity_sse2_cosine -lm -o similarity-dispatch-test
	./similarity-dispatch-test

# Install target
install: all install-lib

print-install-dir:
	@printf '%s\n' "$$package_install_dir"

install-lib: all
	@echo "Installing tclembedding extension..."
	mkdir -p "$$package_install_dir"
	$(INSTALL) $(SHARED_LIB) "$$package_install_dir/"
	$(INSTALL) "$(srcdir)/../pkgIndex.tcl.in" "$$package_install_dir/pkgIndex.tcl"
	$(INSTALL) tcltokenizer.so libtclembedding_tokenizer.so "$$package_install_dir/"
	@echo "✓ Installation complete!"
	@printf '  Extension installed to: %s\n' "$$package_install_dir"

# Full suite requires every fixture explicitly; subset targets remain available.
test:
	@test -n "$(TOKENIZER_JSON)" -a -r "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to a readable tokenizer fixture" >&2; exit 1; }
	@test -n "$(MODEL_ONNX)" -a -r "$(MODEL_ONNX)" || { echo "Set MODEL_ONNX to a readable ONNX model fixture" >&2; exit 1; }
	@test -n "$(SAFETY_FIXTURES)" -a -d "$(SAFETY_FIXTURES)" || { echo "Set SAFETY_FIXTURES to the synthetic fixture directory" >&2; exit 1; }
	$(MAKE) test-tokenizer test-tokenizer-rust test-tokenizer-abi test-tokenizer-embedding test-embedding-lifecycle test-embedding-safety test-embedding-batch

test-tokenizer: tcltokenizer.so pkgIndex.tcl
	@test -n "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to the test fixture"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/tokenizer_test.tcl "$(TOKENIZER_JSON)"

test-tokenizer-rust:
	@test -n "$(TOKENIZER_JSON)" -a -r "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to a readable tokenizer fixture" >&2; exit 1; }
	TOKENIZER_JSON="$(TOKENIZER_JSON)" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" $(CARGO) test --release --locked --manifest-path $(srcdir)/../tokenizer-native/Cargo.toml

tokenizer_abi_test: $(srcdir)/../tests/tokenizer_abi_test.c libtclembedding_tokenizer.so
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ $< -L. -ltclembedding_tokenizer -Wl,-rpath,'$$ORIGIN'

test-tokenizer-abi: tokenizer_abi_test
	@test -n "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to the test fixture"; exit 1; }
	./tokenizer_abi_test "$(TOKENIZER_JSON)"

test-tokenizer-embedding: all
	@test -n "$(TOKENIZER_JSON)" -a -n "$(MODEL_ONNX)" || { echo "Set TOKENIZER_JSON and MODEL_ONNX to the test fixtures"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/tokenizer_embedding_test.tcl "$(TOKENIZER_JSON)" "$(MODEL_ONNX)"

test-embedding-lifecycle: $(SHARED_LIB) pkgIndex.tcl
	@test -n "$(MODEL_ONNX)" || { echo "Set MODEL_ONNX to the test fixture"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/embedding_lifecycle_test.tcl "$(MODEL_ONNX)"

test-embedding-safety: $(SHARED_LIB) pkgIndex.tcl
	@test -n "$(SAFETY_FIXTURES)" || { echo "Set SAFETY_FIXTURES to the generated fixture directory"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/embedding_safety_test.tcl "$(SAFETY_FIXTURES)"

test-embedding-batch: $(SHARED_LIB) pkgIndex.tcl
	@test -n "$(SAFETY_FIXTURES)" || { echo "Set SAFETY_FIXTURES to the generated fixture directory"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/embedding_batch_test.tcl "$(SAFETY_FIXTURES)"

# This focused test is intended for a CPU-only runtime and writes profiles.
test-embedding-provider: $(SHARED_LIB) pkgIndex.tcl
	@test -n "$(MODEL_ONNX)" -a -r "$(MODEL_ONNX)" || { echo "Set MODEL_ONNX to a readable fixture" >&2; exit 1; }
	@test -n "$(PROVIDER_TEST_DIR)" -a -d "$(PROVIDER_TEST_DIR)" || { echo "Set PROVIDER_TEST_DIR to an existing empty private directory" >&2; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/embedding_provider_test.tcl "$(MODEL_ONNX)" "$(PROVIDER_TEST_DIR)"

# Clean targets
clean:
	rm -f $(OBJECTS) $(SHARED_LIB) tokenizer_bridge.o tcltokenizer.so libtclembedding_tokenizer.so tokenizer_abi_test pkgIndex.tcl similarity_dispatch.o similarity_scalar.o similarity_sse2.o similarity_avx.o similarity_avx2.o similarity_dispatch_sse2_test.o similarity-dispatch-test sqlite-similarity.so mysql-cosine-v2.so

distclean: clean
	rm -f Makefile

# Phony targets
.PHONY: all install install-lib print-install-dir test test-tokenizer test-tokenizer-rust test-tokenizer-abi test-tokenizer-embedding test-embedding-lifecycle test-embedding-safety test-embedding-batch test-embedding-provider clean distclean
