# Makefile.in for tclembedding extension - Unix/Linux build
# Generated from unix/Makefile.in by configure
# Follows Tcl Extension Architecture (TEA) standards

VPATH = @srcdir@:@srcdir@/../generic
srcdir = @srcdir@
top_srcdir = @top_srcdir@

# Tcl configuration variables (set by configure)
TCLSH_PROG = @TCLSH_PROG@
TCL_INCLUDE_SPEC = @TCL_INCLUDE_SPEC@
TCL_LIB_SPEC = @TCL_LIB_SPEC@
TCL_LIBS = @TCL_LIBS@
TCL_EXEC_PREFIX = @TCL_EXEC_PREFIX@
TCL_PREFIX = @TCL_PREFIX@

# Installation directories
prefix = @prefix@
exec_prefix = @exec_prefix@
libdir = @libdir@
includedir = @includedir@

# Module installation directory - where the .so file goes
override pkgdir = $(libdir)/tclembedding1.0
override package_install_dir = $(DESTDIR)$(pkgdir)
export package_install_dir

# Compilation settings
CC = @CC@
CFLAGS = @CFLAGS@ -std=c11 -fPIC -Wall -Wextra
INSTALL = @INSTALL@
CARGO ?= cargo
CARGO_TARGET_DIR ?= $(CURDIR)/cargo-target
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@ -lonnxruntime -lm

# Compiler settings
INCLUDE_DIRS = $(TCL_INCLUDE_SPEC) -I$(srcdir)/../generic

# Source files
SOURCES = tclembedding.c
OBJECTS = tclembedding.o

# Output library
SHARED_LIB = tclembedding.so
PACKAGE_NAME = tclembedding
VERSION = 1.0.0

# Default target
all: $(SHARED_LIB) tcltokenizer.so pkgIndex.tcl

pkgIndex.tcl: $(srcdir)/../pkgIndex.tcl.in
	cp $< $@

libtclembedding_tokenizer.so: $(srcdir)/../tokenizer-native/Cargo.toml $(srcdir)/../tokenizer-native/Cargo.lock $(srcdir)/../tokenizer-native/src/lib.rs
	CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" $(CARGO) build --release --locked --manifest-path $(srcdir)/../tokenizer-native/Cargo.toml
	cp "$(CARGO_TARGET_DIR)/release/libtclembedding_tokenizer.so" $@

tokenizer_bridge.o: $(srcdir)/../generic/tokenizer_bridge.c $(srcdir)/../tokenizer-native/hf_tokenizer.h
	$(CC) $(CPPFLAGS) $(CFLAGS) $(INCLUDE_DIRS) -c -o $@ $<

tcltokenizer.so: tokenizer_bridge.o libtclembedding_tokenizer.so
	$(CC) -shared $(LDFLAGS) -o $@ tokenizer_bridge.o -L. -ltclembedding_tokenizer $(TCL_LIB_SPEC) -Wl,-rpath,'$$ORIGIN'

# Build the shared library
$(SHARED_LIB): $(OBJECTS)
	$(CC) -shared $(LDFLAGS) -o $@ $(OBJECTS) $(TCL_LIB_SPEC) $(LIBS)

# Compile C source files
%.o: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(INCLUDE_DIRS) -c -o $@ $<

# Install target
install: all install-lib

print-install-dir:
	@printf '%s\n' "$$package_install_dir"

install-lib: all
	@echo "Installing tclembedding extension..."
	mkdir -p "$$package_install_dir"
	$(INSTALL) $(SHARED_LIB) "$$package_install_dir/"
	$(INSTALL) "$(srcdir)/../pkgIndex.tcl.in" "$$package_install_dir/pkgIndex.tcl"
	$(INSTALL) tcltokenizer.so libtclembedding_tokenizer.so "$$package_install_dir/"
	@echo "✓ Installation complete!"
	@printf '  Extension installed to: %s\n' "$$package_install_dir"

# Full suite requires every fixture explicitly; subset targets remain available.
test:
	@test -n "$(TOKENIZER_JSON)" -a -r "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to a readable tokenizer fixture" >&2; exit 1; }
	@test -n "$(MODEL_ONNX)" -a -r "$(MODEL_ONNX)" || { echo "Set MODEL_ONNX to a readable ONNX model fixture" >&2; exit 1; }
	@test -n "$(SAFETY_FIXTURES)" -a -d "$(SAFETY_FIXTURES)" || { echo "Set SAFETY_FIXTURES to the synthetic fixture directory" >&2; exit 1; }
	$(MAKE) test-tokenizer test-tokenizer-rust test-tokenizer-abi test-tokenizer-embedding test-embedding-lifecycle test-embedding-safety

test-tokenizer: tcltokenizer.so pkgIndex.tcl
	@test -n "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to the test fixture"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/tokenizer_test.tcl "$(TOKENIZER_JSON)"

test-tokenizer-rust:
	@test -n "$(TOKENIZER_JSON)" -a -r "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to a readable tokenizer fixture" >&2; exit 1; }
	TOKENIZER_JSON="$(TOKENIZER_JSON)" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" $(CARGO) test --release --locked --manifest-path $(srcdir)/../tokenizer-native/Cargo.toml

tokenizer_abi_test: $(srcdir)/../tests/tokenizer_abi_test.c libtclembedding_tokenizer.so
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ $< -L. -ltclembedding_tokenizer -Wl,-rpath,'$$ORIGIN'

test-tokenizer-abi: tokenizer_abi_test
	@test -n "$(TOKENIZER_JSON)" || { echo "Set TOKENIZER_JSON to the test fixture"; exit 1; }
	./tokenizer_abi_test "$(TOKENIZER_JSON)"

test-tokenizer-embedding: all
	@test -n "$(TOKENIZER_JSON)" -a -n "$(MODEL_ONNX)" || { echo "Set TOKENIZER_JSON and MODEL_ONNX to the test fixtures"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/tokenizer_embedding_test.tcl "$(TOKENIZER_JSON)" "$(MODEL_ONNX)"

test-embedding-lifecycle: $(SHARED_LIB) pkgIndex.tcl
	@test -n "$(MODEL_ONNX)" || { echo "Set MODEL_ONNX to the test fixture"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/embedding_lifecycle_test.tcl "$(MODEL_ONNX)"

test-embedding-safety: $(SHARED_LIB) pkgIndex.tcl
	@test -n "$(SAFETY_FIXTURES)" || { echo "Set SAFETY_FIXTURES to the generated fixture directory"; exit 1; }
	TCLLIBPATH="$(CURDIR)" $(TCLSH_PROG) $(srcdir)/../tests/embedding_safety_test.tcl "$(SAFETY_FIXTURES)"

# Clean targets
clean:
	rm -f $(OBJECTS) $(SHARED_LIB) tokenizer_bridge.o tcltokenizer.so libtclembedding_tokenizer.so tokenizer_abi_test pkgIndex.tcl

distclean: clean
	rm -f Makefile

# Phony targets
.PHONY: all install install-lib print-install-dir test test-tokenizer test-tokenizer-rust test-tokenizer-abi test-tokenizer-embedding test-embedding-lifecycle test-embedding-safety clean distclean
